            "cpu": "50m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "200m",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "results",
        "emptyDir": {}
