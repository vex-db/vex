{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "client",
    "namespace": "vex-scaling-20260927-hypotheses-r3",
    "labels": {
      "bench.vex.dev/run": "vex-scaling-20260927-hypotheses-r3",
      "role": "client"
    },
    "annotations": {
      "karpenter.sh/do-not-disrupt": "true"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 14400,
    "terminationGracePeriodSeconds": 5,
    "automountServiceAccountToken": false,
