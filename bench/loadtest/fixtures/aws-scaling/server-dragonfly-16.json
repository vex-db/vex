{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "server",
    "namespace": "vex-scaling-20260927-hypotheses-r3",
    "labels": {
      "bench.vex.dev/run": "vex-scaling-20260927-hypotheses-r3",
      "role": "server"
    },
    "annotations": {
      "karpenter.sh/do-not-disrupt": "true"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 14400,
    "terminationGracePeriodSeconds": 5,
    "automountServiceAccountToken": false,
    "shareProcessNamespace": true,
    "nodeSelector": {
      "karpenter.sh/nodepool": "vex-scaling-20260927-hypotheses-r3-server"
    },
    "tolerations": [
      {
        "key": "vex-benchmark",
        "value": "vex-scaling-20260927-hypotheses-r3",
        "operator": "Equal",
        "effect": "NoSchedule"
      }
    ],
    "containers": [
      {
        "name": "engine",
        "image": "docker.dragonflydb.io/dragonflydb/dragonfly@sha256:f1749fc7d2f65abba9db8e6538d5a16e2ea617f0012346d33d3a295f1ea64231",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "/usr/local/bin/dragonfly",
          "--proactor_threads=16",
          "--port=6379",
          "--maxmemory=6gb",
          "--snapshot_cron=",
          "--cache_mode=false"
        ],
        "resources": {
          "requests": {
            "cpu": "16",
            "memory": "8Gi"
          },
          "limits": {
            "cpu": "16",
            "memory": "8Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results"
          }
        ],
        "readinessProbe": {
          "tcpSocket": {
            "port": 6379
          },
          "periodSeconds": 2,
          "failureThreshold": 90
        },
        "securityContext": {
          "seccompProfile": {
            "type": "Unconfined"
          }
        }
      },
      {
        "name": "sampler",
        "image": "208168340597.dkr.ecr.ap-south-1.amazonaws.com/jarvis/vex@sha256:8b65b2d9aa2f12e0733a43b28580d12f261fb6eb541cc202092d85c7e738be9f",
        "command": [
          "sleep",
          "14400"
        ],
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "200m",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results"
          }
        ],
        "securityContext": {
          "capabilities": {
            "add": [
              "SYS_PTRACE"
            ]
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "results",
        "emptyDir": {}
      }
    ],
    "securityContext": {
      "fsGroup": 10001
    }
  }
}
