@@ -0,0 +1,46 @@
+// Local benchmark-client clock repair; application code only.
+#ifndef MEMTIER_MONOTONIC_CLOCK_H
+#define MEMTIER_MONOTONIC_CLOCK_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/time.h>
+#include <time.h>
+
+inline int64_t memtier_clock_us(clockid_t clock)
+{
+    struct timespec ts;
+    if (clock_gettime(clock, &ts) != 0) {
+        perror("memtier clock_gettime");
+        abort();
+    }
+    return (int64_t) ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
+// External inline linkage gives all translation units one C++11 static.
+// Freeze the offset once: later wall-clock adjustments cannot alter intervals.
+inline int64_t memtier_clock_epoch_offset_us()
+{
+    static const int64_t offset = []() {
+        const int64_t epoch = memtier_clock_us(CLOCK_REALTIME);
+        const int64_t monotonic = memtier_clock_us(CLOCK_MONOTONIC);
+        const int64_t value = epoch - monotonic;
+        fprintf(stderr, "MEMTIER_CLOCK {\"clock_source\":\"CLOCK_MONOTONIC\","
+                        "\"epoch_offset_us\":%lld,\"source_tag\":\"2.5.1\","
+                        "\"source_commit\":\"5f634d171b83efca9640c5a87606c47b34d3d330\"}\n",
+                (long long) value);
+        return value;
+    }();
+    return offset;
+}
+
+inline void memtier_gettimeofday(struct timeval *tv)
+{
+    const int64_t offset = memtier_clock_epoch_offset_us();
+    const int64_t epoch_us = offset + memtier_clock_us(CLOCK_MONOTONIC);
+    tv->tv_sec = (time_t) (epoch_us / 1000000);
+    tv->tv_usec = (suseconds_t) (epoch_us % 1000000);
+}
+
+#endif
