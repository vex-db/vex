+test "concurrent_kv import replaces entries and skips tombstones" {
+    var source = KVStore.init(std.testing.allocator, std.testing.io);
+    defer source.deinit();
+    try source.set("live", "value");
+    try source.set("deleted", "gone");
+    try std.testing.expect(source.delete("deleted"));
+
+    var store = ConcurrentKV.init(std.testing.allocator, std.testing.io);
+    store.initStripes();
+    defer store.deinit();
+    try store.importFrom(&source);
+    try std.testing.expectEqual(@as(u64, 9), store.total_bytes.load(.monotonic));
+    try source.set("live", "longer-value");
+    try store.importFrom(&source);
+    try std.testing.expectEqual(@as(usize, 1), store.dbsize());
+    try std.testing.expectEqual(@as(u64, 16), store.total_bytes.load(.monotonic));
+    try std.testing.expect(store.get("deleted") == null);
+    const value = store.get("live") orelse return error.TestUnexpectedResult;
+    defer value.deinit();
+    try std.testing.expectEqualStrings("longer-value", value.data);
+}
