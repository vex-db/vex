+test "concurrent_kv indirect entry allocation failure returns supplied ownership" {
+    if (!build_options.indirect_reactor_entries) return;
+    const alloc = std.testing.allocator;
+    var store = ConcurrentKV.init(alloc, std.testing.io);
+    store.initStripes();
+    defer store.deinit();
+
+    const key = try alloc.dupe(u8, "oom-key");
+    const value = try alloc.dupe(u8, "oom-value");
+    var failing = std.testing.FailingAllocator.init(alloc, .{ .fail_index = 0 });
+    store.allocator = failing.allocator();
+    const stale = store.setPrealloc("oom-key", key, value, 0);
+    store.allocator = alloc;
+
+    try std.testing.expectEqual(@as(usize, 0), store.dbsize());
+    try std.testing.expect(stale.stale_key != null and stale.stale_val != null);
