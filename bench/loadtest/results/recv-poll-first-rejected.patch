+/// The receive poll-first experiment is valid only on the modern deferred
+/// taskrun ring. It is deliberately a strict opt-in; unset and every value
+/// other than "1" preserve the existing receive path.
+fn readRecvPollFirst() bool {
+    const raw = std.c.getenv("VEX_RECV_POLL_FIRST") orelse return false;
+    return std.mem.eql(u8, std.mem.trim(u8, std.mem.span(raw), " \t\r\n"), "1");
+}
+
+// Prefer the Zig std.os.linux ABI names when available. These are the Linux
+// UAPI values from the primary source include/uapi/linux/io_uring.h for
+// toolchains that predate the declarations.
+const IORING_RECVSEND_POLL_FIRST: u16 = if (@hasDecl(linux, "IORING_RECVSEND_POLL_FIRST"))
+    @as(u16, linux.IORING_RECVSEND_POLL_FIRST)
+else
+    @as(u16, 1 << 0);
+const IORING_CQE_F_SOCK_NONEMPTY: u32 = if (@hasDecl(linux, "IORING_CQE_F_SOCK_NONEMPTY"))
+    @as(u32, linux.IORING_CQE_F_SOCK_NONEMPTY)
+else
+    @as(u32, 1 << 2);
